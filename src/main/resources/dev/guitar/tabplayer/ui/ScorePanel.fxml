<?xml version="1.0" encoding="UTF-8"?>
<?import dev.guitar.tabplayer.ui.controls.ScoreView?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.shape.Rectangle?>

<!-- Graphical visualization: multi-row score sheet, vertically scrolled.
     The canvas is viewport-sized and only visible rows are drawn; the
     transparent spacer gives the scroll pane its virtual content height. -->
<HBox fx:id="scoreArea" fx:controller="dev.guitar.tabplayer.ui.controllers.ScorePanelController"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
  <ScrollPane fx:id="scoreScroll" styleClass="score-scroll" vbarPolicy="ALWAYS"
              hbarPolicy="NEVER" fitToWidth="true" HBox.hgrow="ALWAYS">
    <content>
      <Group>
        <children>
          <Rectangle fx:id="spacer" fill="transparent" mouseTransparent="true"/>
          <ScoreView fx:id="scoreView" managed="false"/>
        </children>
      </Group>
    </content>
  </ScrollPane>
</HBox>
