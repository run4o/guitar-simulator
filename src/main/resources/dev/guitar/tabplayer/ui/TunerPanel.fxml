<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Tuner panel: play the synth's open-string reference tones so a real
     guitar can be tuned by ear against the current tuning. Button
     captions follow the live tuning. -->
<VBox fx:controller="dev.guitar.tabplayer.ui.controllers.TunerPanelController"
      spacing="6" alignment="TOP_LEFT" styleClass="panel"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="8" right="10" bottom="8" left="10"/>
  </padding>
  <Label text="TUNER" styleClass="model-tag"/>
  <Label fx:id="readout" text="PICK A STRING" styleClass="lcd, tuner-readout"/>
  <HBox fx:id="stringButtons" spacing="4" alignment="TOP_CENTER"/>
</VBox>
