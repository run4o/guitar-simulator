<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<!-- Tuner panel, squished to one row: play the synth's open-string
     reference tones so a real guitar can be tuned by ear against the
     current tuning. -->
<HBox fx:controller="dev.guitar.tabplayer.ui.controllers.TunerPanelController"
      spacing="10" alignment="CENTER_LEFT" styleClass="panel"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="8" right="10" bottom="8" left="10"/>
  </padding>
  <Label text="TUNER" styleClass="model-tag" minWidth="-Infinity"/>
  <Label fx:id="readout" text="PICK A STRING" styleClass="lcd, tuner-readout"
         HBox.hgrow="ALWAYS" maxWidth="Infinity"/>  <HBox fx:id="stringButtons" spacing="4" alignment="CENTER_LEFT"/>
</HBox>
