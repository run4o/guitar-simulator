<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>

<!-- Sheet header: tab title, bar-block operations, view toggle and the
     parse-warning badge. Button behavior is wired by the tab panel. -->
<HBox fx:controller="dev.guitar.tabplayer.ui.controllers.SheetHeaderController"
      spacing="10" alignment="CENTER_LEFT" styleClass="panel"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
  <Label text="TITLE" styleClass="model-tag"/>
  <TextField fx:id="titleField" text="DEMO — INTRO RIFF (LET RING)"
             styleClass="title-field" HBox.hgrow="ALWAYS"/>
  <Button fx:id="copyBtn" text="COPY" styleClass="btn-steel"/>
  <Button fx:id="cutBtn" text="CUT" styleClass="btn-steel"/>
  <Button fx:id="pasteBtn" text="PASTE" styleClass="btn-steel"/>
  <Button fx:id="dupBtn" text="DUP" styleClass="btn-steel"/>
  <Button fx:id="delBtn" text="DEL" styleClass="btn-steel"/>
  <Button fx:id="clearBtn" text="CLEAR" styleClass="btn-steel"/>
  <Region HBox.hgrow="ALWAYS" minWidth="0"/>
  <Button fx:id="pedalsBtn" text="PEDALS" styleClass="btn-steel"/>
  <Button fx:id="editToggle" text="VIEW: SOURCE" styleClass="btn-steel"/>
  <Pane fx:id="warningBadge" styleClass="led, led-red" visible="false" managed="false"/>
</HBox>
